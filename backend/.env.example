SMARTEX_DATA_SOURCE=mock
SMARTEX_DB_PATH=./data/smartex_backend.sqlite3
SMARTEX_API_TOKEN=
REQUIRE_AUTH_FOR_SNAPSHOT=false

# Optional live InfluxDB source. Leave SMARTEX_DATA_SOURCE=mock for local demos.
INFLUX_URL=https://influxdb.smartex.example
INFLUX_TOKEN=change-me
INFLUX_ORG=smartex
INFLUX_BUCKET=telemetry
INFLUX_MEASUREMENT=smartex_derived

# Optional AI assistance. Without a key, /assist/query returns deterministic guidance.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_TIMEOUT_SECONDS=20
